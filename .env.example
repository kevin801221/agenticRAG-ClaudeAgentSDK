# ── engine 選擇 ──────────────────────────────────────
ENGINE=agent_sdk                 # agent_sdk | litellm

# ── engine=agent_sdk：三選一 ─────────────────────────
# (1) OAuth 訂閱 — 推薦，不需要任何 API key，不計費
#     先跑一次：claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# (2) 任何 Anthropic 相容端點（DeepSeek / Kimi / GLM / OpenRouter / LiteLLM proxy）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=deepseek-chat

# (3) Anthropic 官方 API key（會計費）
# ANTHROPIC_API_KEY=

# ── engine=litellm：原生接其他 provider ───────────────
# LLM_MODEL=ollama/qwen3           # 本地跑，完全免費離線，不需要任何 key
# LLM_MODEL=gemini/gemini-3-pro
# LLM_MODEL=openai/gpt-5
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── 檢索層 ──────────────────────────────────────────
EMBEDDING=local                  # local | none（none = 純 BM25，不下載模型）
VECTOR_STORE=numpy               # numpy | chroma
#   numpy  = 向量放記憶體暴力算 cosine。6601 筆純檢索 0.089 ms
#   chroma = 同一份向量交給 Chroma 管。同樣 6601 筆 0.399 ms —— 這個規模反而慢 4.5 倍，
#            因為 HNSW 的索引開銷還賺不回來。幾十萬筆以上、或要增量更新才划算。
#   兩者答案完全一致（tests/test_retrieval.py 有一條測試專門盯這件事）。
#   切換不用重建索引：vectors.npy 永遠是原始資料，chroma 第一次啟動會自己從它灌進去。
EMBEDDING_MODEL=intfloat/multilingual-e5-small
MAX_TURNS=12

# ── 圖資料庫（選用，Neo4j）────────────────────────────────
# 設了才會出現「圖譜」那一格。沒設的話整個系統照常跑，只是少一個資料源。
#   docker run -d --name neo4j-teach -p 7474:7474 -p 7687:7687 \
#     -e NEO4J_AUTH=neo4j/你的密碼 neo4j:5
#   uv run python scripts/seed_neo4j.py     # 把現有索引灌成圖
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
